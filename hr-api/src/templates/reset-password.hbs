<!DOCTYPE html
    PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html style="width:100%;font-family: 'Montserrat', 'Helvetica Neue', Helvetica, Arial, 'sans-serif';">

<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting">
    <link href="https://fonts.googleapis.com/css?family=Montserrat:100,200,300,400,500,600,700,800" rel="stylesheet">
    <style type="text/css">
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap');

        body,
        table,
        td,
        p,
        a,
        li {
            font-family: 'Montserrat', 'Helvetica Neue', Helvetica, Arial, sans-serif !important;
        }

        p {
            font-size: 16px;
        }
    </style>
</head>

<body>
    <div style="max-width: 768px; margin: 0 auto;">
        <table align="center"
            style="border-spacing: 0; color: #333333; font-family: 'Montserrat'; max-width: 768px; width: 100%;">
            <tbody>
                {{> header }}

                <!-- Content -->
                <tr>
                    <td style="padding: 20px; text-align: left; width: 100%;">
                        <p style="width: 88%; margin: 0 auto; color: #000;">
                            Hi {{name}},
                        </p>
                        <p style="width: 88%; margin: 10px auto; color: #000;">
                            We received a request to reset your password for your {{#if
                            organization.name}}{{organization.name}}{{else}}Letshire{{/if}} account.
                        </p>
                        <p style="width: 88%; margin: 10px auto; color: #000;">
                            Click the button below to set a new password. This link will expire in 1 hour.
                        </p>
                        <p style="width: 88%; margin: 20px auto; text-align: center;">
                            <a href="{{resetLink}}" target="_blank"
                                style="display: inline-block; background-color: {{organization.primaryColor}}; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px;">
                                Reset Password
                            </a>
                        </p>
                        <p style="width: 88%; margin: 10px auto; color: #000;">
                            If you did not request this, you can safely ignore this email. Your password will remain
                            unchanged.
                        </p>
                    </td>
                </tr>

                <tr>
                    <td style="padding: 20px; text-align: left; width: 100%;">
                        <p style="width: 88%; margin: 0 auto 0; color: #000;">Best regards,</p>
                        <p style="width: 88%; margin: 0 auto 0; color: #000;">The {{#if
                            organization.name}}{{organization.name}}{{else}}Letshire{{/if}} Team</p>
                    </td>
                </tr>

                {{> footer }}
            </tbody>
        </table>
    </div>
</body>

</html>
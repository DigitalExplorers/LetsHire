# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=hrSolutionUser
DB_PASS=your_database_password_here
DB_NAME=hrSolution

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Email — SendGrid SMTP
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=465
MAIL_USER=apikey
MAIL_PASS=your_sendgrid_api_key_here
DEFAULT_EMAIL_ADDRESS=noreply@yourdomain.com

# AWS
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=your_aws_account_id
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name

# AWS Bedrock AI
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_AWS_REGION=ap-south-1

# Frontend URLs (used in emails and CORS)
FRONTEND_DASHBOARD=http://localhost:3000
FRONTEND_MOBILE_URL=http://localhost:5173
FRONTEND_MOBILE=http://localhost:5173

# Additional CORS origins for production (comma-separated list of allowed URLs)
# Example: CORS_EXTRA_ORIGINS=https://app.yourdomain.com,https://dashboard.yourdomain.com
CORS_EXTRA_ORIGINS=

# External AI analysis service (optional)
AI_URL=http://localhost:5000

# Default organization branding (used as fallback when an org has incomplete branding)
DEFAULT_ORG_NAME=HR Platform
DEFAULT_LOGO_URL=
DEFAULT_ORG_ADDRESS=
DEFAULT_SUPPORT_EMAIL=
DEFAULT_PRIMARY_COLOR=#be1d2c

# Super admin seed credentials (used only on first deployment via the seeder)
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=your_secure_superadmin_password_here

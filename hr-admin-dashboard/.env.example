# Asset hosting configuration
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=your_aws_account_id
NEXT_PUBLIC_S3_BUCKET_NAME=your-bucket-name

# API endpoints
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:4000
LOCALHOST_URL=http://localhost:4000

# #Production environment
# NODE_ENV=production 
# NEXT_PUBLIC_API_URL=your_production_api_url
# LOCALHOST_URL=your_production_api_url

# Authentication — must match JWT_SECRET in hr-api
JWT_SECRET=your_jwt_secret_key_here

# Cookie domain (production only), e.g. .example.com
NEXT_PUBLIC_COOKIE_DOMAIN=.your-domain.com

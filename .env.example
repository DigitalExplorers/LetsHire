# ---------------------------------------------------------------------------
# DATABASE (PostgreSQL) — used by hr-api
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=hrSolutionUser
POSTGRES_PASSWORD=your_database_password_here
POSTGRES_DB=hrSolution

# ---------------------------------------------------------------------------
# AUTHENTICATION — used by hr-api and hr-admin-dashboard
# The JWT_SECRET must match between both services.
# ---------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_here

# ---------------------------------------------------------------------------
# EMAIL — SendGrid SMTP — used by hr-api
# ---------------------------------------------------------------------------
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=465
MAIL_USER=apikey
MAIL_PASS=your_sendgrid_api_key_here
DEFAULT_EMAIL_ADDRESS=noreply@yourdomain.com

# ---------------------------------------------------------------------------
# AWS — used by hr-api and hr-admin-dashboard
# ---------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=your_aws_account_id
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name

# Next.js public env (asset hosting) — used by hr-admin-dashboard
NEXT_PUBLIC_S3_BUCKET_NAME=your-bucket-name

# ---------------------------------------------------------------------------
# AWS BEDROCK AI — used by hr-api
# ---------------------------------------------------------------------------
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_AWS_REGION=ap-south-1

# ---------------------------------------------------------------------------
# API ENDPOINTS — used by hr-admin-dashboard and hr-candidate-portal
# ---------------------------------------------------------------------------
# Backend API base URL consumed by the admin dashboard (server-side)
LOCALHOST_URL=http://localhost:4000

# Public API URL for the admin dashboard (browser-side)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public API URL for the candidate portal (Vite exposes VITE_* vars to the browser)
VITE_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# FRONTEND URLS — used by hr-api (CORS, email links) and hr-candidate-portal
# ---------------------------------------------------------------------------
FRONTEND_DASHBOARD=http://localhost:3000
FRONTEND_MOBILE_URL=http://localhost:5173
FRONTEND_MOBILE=http://localhost:5173

# Candidate portal public URL — used in OG/Twitter meta tags
# Dev: http://localhost:5173  |  Prod: https://your-portal.yourdomain.com
VITE_APP_URL=http://localhost:5173

# Candidate portal domain — used by hr-api for email link generation
FRONTEND_PORTAL_DOMAIN=your-portal.yourdomain.com

# ---------------------------------------------------------------------------
# CORS — used by hr-api
# Additional allowed origins for production (comma-separated).
# Example: CORS_EXTRA_ORIGINS=https://app.yourdomain.com,https://dashboard.yourdomain.com
# ---------------------------------------------------------------------------
CORS_EXTRA_ORIGINS=

# ---------------------------------------------------------------------------
# ENVIRONMENT — used by hr-api and hr-admin-dashboard
# ---------------------------------------------------------------------------
NODE_ENV=development

# Production overrides (uncomment for production):
# NODE_ENV=production
# NEXT_PUBLIC_API_URL=your_production_api_url
# LOCALHOST_URL=your_production_api_url

# ---------------------------------------------------------------------------
# EXTERNAL AI SERVICE — used by hr-api (optional)
# ---------------------------------------------------------------------------
AI_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# DEFAULT ORGANIZATION BRANDING — used by hr-api
# Fallback values when an org has incomplete branding.
# ---------------------------------------------------------------------------
DEFAULT_ORG_NAME=HR Platform
DEFAULT_LOGO_URL=
DEFAULT_ORG_ADDRESS=
DEFAULT_SUPPORT_EMAIL=
DEFAULT_PRIMARY_COLOR=#be1d2c

# ---------------------------------------------------------------------------
# SUPER ADMIN SEED — used by hr-api (first deployment only)
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=your_secure_superadmin_password_here

# ---------------------------------------------------------------------------
# COOKIE DOMAIN — used by hr-admin-dashboard (production only)
# Example: .example.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_COOKIE_DOMAIN=.your-domain.com
